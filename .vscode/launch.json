{
  "configurations": [
    {
      "name": "ST-Link: Debug Blink",
      "cwd": "${workspaceFolder}/blink",
      "executable": "./main.elf",
      "servertype": "stutil",
      "request": "launch",
      "type": "cortex-debug",
      "device": "STM32F411RE",
      "runToEntryPoint": "main",
      "interface": "swd",
      "preLaunchTask": "build_debug"
    },
    {
      "name": "ST-Link: Debug pwm_timer",
